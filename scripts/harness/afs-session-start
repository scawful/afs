#!/usr/bin/env python3
"""Supply one compact AFS briefing to a native client at session start."""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--host", choices=("claude", "codex", "gemini", "cursor"), required=True)
parser.add_argument("--agent-name", help="Name used for 'waiting for you' lookups (default: host).")
args = parser.parse_args()
agent_name = args.agent_name or args.host
# AFS_ROOT wins; otherwise use the checkout this script lives in (scripts/harness/..).
runtime = Path(os.environ.get("AFS_ROOT") or Path(__file__).resolve().parents[2])


def emit(text: str) -> None:
    if args.host == "cursor":
        print(json.dumps({"additional_context": text}, ensure_ascii=False))
        return
    output = {"additionalContext": text}
    if args.host in ("claude", "codex"):
        output["hookEventName"] = "SessionStart"
    print(json.dumps({"hookSpecificOutput": output}, ensure_ascii=False))


try:
    request = json.load(sys.stdin)
    if not isinstance(request, dict):
        raise ValueError("hook input must be a JSON object")
    roots = request.get("workspace_roots") or []
    cwd_value = request.get("cwd") or (roots[0] if roots else "") or os.getcwd()
    cwd = Path(cwd_value).expanduser().resolve()
    env = dict(os.environ)
    env.update(AFS_ROOT=str(runtime), AFS_VENV=str(runtime / ".venv"),
               AFS_PYTHON=str(runtime / ".venv/bin/python"),
               AFS_PROMPT_SCAFFOLDING="minimal", AFS_NATIVE_SKILLS="1")
    result = subprocess.run(
        [str(runtime / "scripts/afs"), "session", "bootstrap", "--short",
         "--agent-name", agent_name, "--path", str(cwd)],
        cwd=cwd, env=env, capture_output=True, text=True, timeout=10,
    )
    if result.returncode:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise ValueError(detail[-500:])
    emit(f"AFS short bootstrap for {agent_name} (already loaded for this session):\n"
         + result.stdout.strip())
except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
    if args.host == "cursor":
        emit(f"AFS short bootstrap unavailable: {exc}")
    else:
        print(json.dumps({"systemMessage": f"AFS short bootstrap unavailable: {exc}"}))
