#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: afs-upgrade-agent-setup [options]

Upgrade local agent harnesses around the current AFS checkout.

Default mode is a dry-run: it runs read-only checks and prints write commands.
Add --apply to copy skills, write manifest exports, repair context metadata,
or update client MCP config.

Options:
  --workspace PATH        Project/workspace to repair and inspect (default: $PWD)
  --harness NAME          Limit manifest sync to a harness; repeatable
  --apply                 Apply write operations
  --full                  Full local harness defaults: Codex/Claude/Gemini/Antigravity
                          manifest sync, shell hooks, and index rebuild
  --work                  Compatibility alias for --full
  --all                   Enable common write operations when paired with --apply
                          (shell hooks, worker, Claude/Gemini/Antigravity MCP, index rebuild)
  --rebuild-index         Rebuild the workspace SQLite context index during repair
  --install-shell-hooks   Install idempotent shell wrappers for agent commands
  --install-worker        Install/load the background agent-jobs LaunchAgent
  --setup-claude          Write Claude MCP setup for the selected scope
  --setup-gemini          Write Gemini MCP setup for the selected scope
  --setup-antigravity     Preview/write Antigravity CLI MCP setup for the selected scope
  --setup-hcode           Sync hcode slash commands/manifest and smoke bootstrap
  --halext-code PATH      halext-code checkout for explicit hcode setup
  --skill-root NAME=PATH  Override a harness skill destination; repeatable
  --command-root NAME=PATH
                          Override a harness command destination; repeatable
  --export-path NAME=PATH Override a harness manifest export; repeatable
  --claude-scope SCOPE    project or user (default: project)
  --gemini-scope SCOPE    project or user (default: project)
  --antigravity-scope SCOPE
                          project or user (default: project)
  --force-mcp             Pass --force to Claude/Gemini/Antigravity MCP setup
  --skip-venv             Do not create/update the AFS venv
  --skip-manifest-sync    Do not validate/sync the harness manifest
  --skip-context-repair   Do not run context repair
  -h, --help              Show this help

Examples:
  scripts/afs-upgrade-agent-setup --workspace .
  scripts/afs-upgrade-agent-setup --workspace . --apply --all
  scripts/afs-upgrade-agent-setup --workspace . --setup-hcode --halext-code /path/to/halext-code
  scripts/afs-upgrade-agent-setup --workspace . --setup-hcode --halext-code /path/to/halext-code --apply
  scripts/afs-upgrade-agent-setup --apply --harness codex --harness claude
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AFS_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
AFS_CLI="${SCRIPT_DIR}/afs"

WORKSPACE="${AFS_UPGRADE_WORKSPACE:-$PWD}"
APPLY=0
FULL_MODE=0
RUN_VENV=1
RUN_MANIFEST=1
RUN_CONTEXT_REPAIR=1
REBUILD_INDEX=0
INSTALL_SHELL_HOOKS=0
INSTALL_WORKER=0
SETUP_CLAUDE=0
SETUP_GEMINI=0
SETUP_ANTIGRAVITY=0
SETUP_HCODE=0
CLAUDE_SCOPE="project"
GEMINI_SCOPE="project"
ANTIGRAVITY_SCOPE="project"
FORCE_MCP=0
HALEXT_CODE_PATH="${AFS_HALEXT_CODE_PATH:-}"
HARNESSES=()
SKILL_ROOT_OVERRIDES=()
COMMAND_ROOT_OVERRIDES=()
EXPORT_PATH_OVERRIDES=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --workspace|-C)
      WORKSPACE="${2:-}"
      shift 2
      ;;
    --harness)
      HARNESSES+=("${2:-}")
      shift 2
      ;;
    --apply)
      APPLY=1
      shift
      ;;
    --full)
      FULL_MODE=1
      shift
      ;;
    --work)
      FULL_MODE=1
      shift
      ;;
    --all)
      REBUILD_INDEX=1
      INSTALL_SHELL_HOOKS=1
      INSTALL_WORKER=1
      SETUP_CLAUDE=1
      SETUP_GEMINI=1
      SETUP_ANTIGRAVITY=1
      shift
      ;;
    --rebuild-index)
      REBUILD_INDEX=1
      shift
      ;;
    --install-shell-hooks)
      INSTALL_SHELL_HOOKS=1
      shift
      ;;
    --install-worker)
      INSTALL_WORKER=1
      shift
      ;;
    --setup-claude)
      SETUP_CLAUDE=1
      shift
      ;;
    --setup-gemini)
      SETUP_GEMINI=1
      shift
      ;;
    --setup-antigravity)
      SETUP_ANTIGRAVITY=1
      shift
      ;;
    --setup-hcode)
      SETUP_HCODE=1
      shift
      ;;
    --halext-code)
      HALEXT_CODE_PATH="${2:-}"
      shift 2
      ;;
    --skill-root)
      SKILL_ROOT_OVERRIDES+=("${2:-}")
      shift 2
      ;;
    --command-root)
      COMMAND_ROOT_OVERRIDES+=("${2:-}")
      shift 2
      ;;
    --export-path)
      EXPORT_PATH_OVERRIDES+=("${2:-}")
      shift 2
      ;;
    --claude-scope)
      CLAUDE_SCOPE="${2:-}"
      shift 2
      ;;
    --gemini-scope)
      GEMINI_SCOPE="${2:-}"
      shift 2
      ;;
    --antigravity-scope)
      ANTIGRAVITY_SCOPE="${2:-}"
      shift 2
      ;;
    --force-mcp)
      FORCE_MCP=1
      shift
      ;;
    --skip-venv)
      RUN_VENV=0
      shift
      ;;
    --skip-manifest-sync)
      RUN_MANIFEST=0
      shift
      ;;
    --skip-context-repair)
      RUN_CONTEXT_REPAIR=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

append_harness_once() {
  local name="$1"
  local harness
  for harness in "${HARNESSES[@]}"; do
    if [ "$harness" = "$name" ]; then
      return
    fi
  done
  HARNESSES+=("$name")
}

has_harness_override() {
  local name="$1"
  shift
  local item
  for item in "$@"; do
    if [ "${item%%=*}" = "$name" ]; then
      return 0
    fi
  done
  return 1
}

if [ "$FULL_MODE" -eq 1 ]; then
  REBUILD_INDEX=1
  INSTALL_SHELL_HOOKS=1
  SETUP_CLAUDE=1
  SETUP_GEMINI=1
  SETUP_ANTIGRAVITY=1
  if [ "${#HARNESSES[@]}" -eq 0 ]; then
    HARNESSES=(codex claude gemini antigravity)
  fi
fi

if [ "$SETUP_HCODE" -eq 1 ]; then
  append_harness_once hcode
fi
if [ "$SETUP_CLAUDE" -eq 1 ]; then
  append_harness_once claude
fi
if [ "$SETUP_GEMINI" -eq 1 ]; then
  append_harness_once gemini
fi
if [ "$SETUP_ANTIGRAVITY" -eq 1 ]; then
  append_harness_once antigravity
fi

if [ -z "$WORKSPACE" ]; then
  echo "--workspace requires a path" >&2
  exit 2
fi
if [ ! -d "$WORKSPACE" ]; then
  echo "workspace is not a directory: $WORKSPACE" >&2
  exit 2
fi
if [ "$CLAUDE_SCOPE" != "project" ] && [ "$CLAUDE_SCOPE" != "user" ]; then
  echo "--claude-scope must be project or user" >&2
  exit 2
fi
if [ "$GEMINI_SCOPE" != "project" ] && [ "$GEMINI_SCOPE" != "user" ]; then
  echo "--gemini-scope must be project or user" >&2
  exit 2
fi
if [ "$ANTIGRAVITY_SCOPE" != "project" ] && [ "$ANTIGRAVITY_SCOPE" != "user" ]; then
  echo "--antigravity-scope must be project or user" >&2
  exit 2
fi
if [ "$SETUP_HCODE" -eq 1 ]; then
  if [ -z "$HALEXT_CODE_PATH" ]; then
    echo "--setup-hcode requires --halext-code PATH or AFS_HALEXT_CODE_PATH" >&2
    exit 2
  fi
  case "$HALEXT_CODE_PATH" in
    "~") HALEXT_CODE_PATH="$HOME" ;;
    "~/"*) HALEXT_CODE_PATH="$HOME/${HALEXT_CODE_PATH#~/}" ;;
  esac
  if [ ! -d "$HALEXT_CODE_PATH" ]; then
    echo "halext-code is not a directory: $HALEXT_CODE_PATH" >&2
    exit 2
  fi
  HALEXT_CODE_PATH="$(cd "$HALEXT_CODE_PATH" && pwd)"
fi
for harness in "${HARNESSES[@]}"; do
  if [ -z "$harness" ]; then
    echo "--harness requires a non-empty name" >&2
    exit 2
  fi
done

WORKSPACE="$(cd "$WORKSPACE" && pwd)"

print_command() {
  printf '+'
  printf ' %q' "$@"
  printf '\n'
}

run_cmd() {
  print_command "$@"
  "$@"
}

plan_cmd() {
  printf 'next:'
  printf ' %q' "$@"
  printf '\n'
}

run_or_plan_write() {
  if [ "$APPLY" -eq 1 ]; then
    run_cmd "$@"
  else
    plan_cmd "$@"
  fi
}

echo "AFS agent setup upgrade"
echo "mode: $([ "$APPLY" -eq 1 ] && echo apply || echo dry-run)"
echo "afs_root: ${AFS_ROOT}"
echo "workspace: ${WORKSPACE}"
echo "mcp_catalog: slim default; use AFS_MCP_TOOL_CATALOG=full or mcp serve --tool-catalog full for debug/admin tools"
if [ "$FULL_MODE" -eq 1 ]; then
  echo "full_mode: enabled"
fi
echo

run_cmd "$AFS_CLI" status --start-dir "$WORKSPACE"
echo

if [ "$RUN_VENV" -eq 1 ]; then
  if [ "$APPLY" -eq 1 ]; then
    run_cmd "${SCRIPT_DIR}/afs-venv"
  else
    plan_cmd "${SCRIPT_DIR}/afs-venv"
  fi
  echo
fi

if [ "$RUN_MANIFEST" -eq 1 ]; then
  run_cmd "$AFS_CLI" agent-manifest validate --check-paths

  manifest_sync_args=(agent-manifest sync)
  for harness in "${HARNESSES[@]}"; do
    manifest_sync_args+=(--harness "$harness")
    if { [ "$harness" = "gemini" ] || [ "$harness" = "antigravity" ]; } &&
      ! has_harness_override "$harness" "${SKILL_ROOT_OVERRIDES[@]}"; then
      # Gemini CLI and Antigravity both recognize this vendor-neutral alias.
      manifest_sync_args+=(--skill-root "$harness=${WORKSPACE}/.agents/skills")
    fi
  done
  if [ "$SETUP_HCODE" -eq 1 ] && ! has_harness_override hcode "${SKILL_ROOT_OVERRIDES[@]}"; then
    manifest_sync_args+=(--skill-root "hcode=${HALEXT_CODE_PATH}/.opencode/skills")
  fi
  if [ "$SETUP_HCODE" -eq 1 ] && ! has_harness_override hcode "${COMMAND_ROOT_OVERRIDES[@]}"; then
    manifest_sync_args+=(--command-root "hcode=${HALEXT_CODE_PATH}/.opencode/commands")
  fi
  for override in "${SKILL_ROOT_OVERRIDES[@]}"; do
    manifest_sync_args+=(--skill-root "$override")
  done
  for override in "${COMMAND_ROOT_OVERRIDES[@]}"; do
    manifest_sync_args+=(--command-root "$override")
  done
  for override in "${EXPORT_PATH_OVERRIDES[@]}"; do
    manifest_sync_args+=(--export-path "$override")
  done
  if [ "$APPLY" -eq 1 ]; then
    manifest_sync_args+=(--apply)
  fi
  run_cmd "$AFS_CLI" "${manifest_sync_args[@]}"
  echo
fi

if [ "$RUN_CONTEXT_REPAIR" -eq 1 ]; then
  if [ "$APPLY" -eq 1 ]; then
    repair_args=(context repair --path "$WORKSPACE" --json)
    if [ "$REBUILD_INDEX" -eq 1 ]; then
      repair_args+=(--rebuild-index)
    fi
    run_cmd "$AFS_CLI" "${repair_args[@]}"
  else
    run_cmd "$AFS_CLI" context repair --path "$WORKSPACE" --dry-run --json
  fi
  echo
elif [ "$REBUILD_INDEX" -eq 1 ]; then
  run_or_plan_write "$AFS_CLI" index rebuild --path "$WORKSPACE" --json
  echo
fi

if [ "$REBUILD_INDEX" -eq 0 ]; then
  echo "index rebuild skipped; command:"
  plan_cmd "$AFS_CLI" index rebuild --path "$WORKSPACE" --json
  echo
fi

if [ "$INSTALL_SHELL_HOOKS" -eq 1 ]; then
  shell_args=(agent-hooks install-shell --afs-root "$AFS_ROOT")
  if [ "$APPLY" -eq 1 ]; then
    shell_args+=(--apply)
  fi
  run_cmd "$AFS_CLI" "${shell_args[@]}"
else
  echo "shell hooks not requested; command:"
  plan_cmd "$AFS_CLI" agent-hooks install-shell --afs-root "$AFS_ROOT" --apply
fi
echo

if [ "$INSTALL_WORKER" -eq 1 ]; then
  worker_args=(agent-hooks install-worker --afs-root "$AFS_ROOT" --path "$WORKSPACE")
  if [ "$APPLY" -eq 1 ]; then
    worker_args+=(--apply --load)
  fi
  run_cmd "$AFS_CLI" "${worker_args[@]}"
else
  echo "background worker not requested; command:"
  plan_cmd "$AFS_CLI" agent-hooks install-worker --afs-root "$AFS_ROOT" --path "$WORKSPACE" --apply --load
fi
echo

if [ "$SETUP_CLAUDE" -eq 1 ]; then
  claude_args=(claude setup --scope "$CLAUDE_SCOPE" --path "$WORKSPACE")
  if [ "$FORCE_MCP" -eq 1 ]; then
    claude_args+=(--force)
  fi
  run_or_plan_write "$AFS_CLI" "${claude_args[@]}"
else
  echo "Claude MCP setup not requested; command:"
  plan_cmd "$AFS_CLI" claude setup --scope project --path "$WORKSPACE"
fi
echo

if [ "$SETUP_GEMINI" -eq 1 ]; then
  gemini_args=(gemini setup --scope "$GEMINI_SCOPE")
  if [ "$GEMINI_SCOPE" = "project" ]; then
    gemini_args+=(--project-path "$WORKSPACE")
  fi
  if [ "$FORCE_MCP" -eq 1 ]; then
    gemini_args+=(--force)
  fi
  run_or_plan_write "$AFS_CLI" "${gemini_args[@]}"
else
  echo "Gemini compatibility setup not requested; command:"
  plan_cmd "$AFS_CLI" gemini setup --scope project --project-path "$WORKSPACE"
fi
echo

if [ "$SETUP_ANTIGRAVITY" -eq 1 ]; then
  antigravity_args=(antigravity setup --scope "$ANTIGRAVITY_SCOPE")
  if [ "$ANTIGRAVITY_SCOPE" = "project" ]; then
    antigravity_args+=(--project-path "$WORKSPACE")
  fi
  if [ "$FORCE_MCP" -eq 1 ]; then
    antigravity_args+=(--force)
  fi
  if [ "$APPLY" -eq 1 ]; then
    antigravity_args+=(--apply)
  fi
  run_cmd "$AFS_CLI" "${antigravity_args[@]}"
else
  echo "Antigravity CLI setup not requested; command:"
  plan_cmd "$AFS_CLI" antigravity setup --scope project --project-path "$WORKSPACE" --apply
fi
echo

if [ "$SETUP_HCODE" -eq 1 ]; then
  echo "hcode setup:"
  echo "halext_code: ${HALEXT_CODE_PATH}"
  hcode_smoke="cd $(printf '%q' "$HALEXT_CODE_PATH") && $(printf '%q' "${SCRIPT_DIR}/afs-hcode") --bootstrap-only"
  run_or_plan_write bash -lc "$hcode_smoke"
else
  echo "hcode setup not requested; command:"
  plan_cmd "$0" --workspace "$WORKSPACE" --setup-hcode
fi
echo

run_cmd "$AFS_CLI" agent-hooks status --path "$WORKSPACE"

echo
echo "Review commands:"
plan_cmd "$AFS_CLI" agent-jobs status --path "$WORKSPACE"
plan_cmd "$AFS_CLI" agent-jobs inbox --path "$WORKSPACE"
plan_cmd "$AFS_CLI" work communication preflight --path "$WORKSPACE"
plan_cmd "$AFS_CLI" session bootstrap --json

if [ "$APPLY" -eq 0 ]; then
  echo
  if [ "$FULL_MODE" -eq 1 ]; then
    echo "Apply the full local harness upgrade with:"
    plan_cmd "$0" --workspace "$WORKSPACE" --full --apply
  else
    echo "Apply the common local upgrade with:"
    plan_cmd "$0" --workspace "$WORKSPACE" --apply --all
  fi
fi
