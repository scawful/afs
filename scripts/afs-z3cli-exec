#!/usr/bin/env bash
set -euo pipefail

if [ -n "${Z3CLI_SCRIPT:-}" ]; then
  exec "${Z3CLI_PYTHON:-python3}" "${Z3CLI_SCRIPT}" "$@"
fi

Z3CLI_BIN="${Z3CLI_BIN:-z3cli}"
if ! command -v "$Z3CLI_BIN" >/dev/null 2>&1; then
  echo "z3cli executable not found; put it on PATH or set Z3CLI_BIN/Z3CLI_SCRIPT." >&2
  exit 127
fi
exec "$Z3CLI_BIN" "$@"
