<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.afs.supervisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__AFS_PYTHON__</string>
        <string>-m</string>
        <string>afs.agents.supervisor</string>
        <string>--max-runs</string>
        <string>1</string>
        <string>--quiet</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__AFS_PATH__</string>
        <key>AFS_ROOT</key>
        <string>__AFS_ROOT__</string>
        <key>PYTHONPATH</key>
        <string>__AFS_ROOT__/src</string>
    </dict>

    <!-- Run every 15 minutes -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Also run on load -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>__AFS_LOG_DIR__/supervisor.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__AFS_LOG_DIR__/supervisor.stderr.log</string>

    <!-- Resource limits — keep it lightweight -->
    <key>Nice</key>
    <integer>10</integer>

    <!-- Don't restart too fast on failure -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- Keep alive only if launched -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
